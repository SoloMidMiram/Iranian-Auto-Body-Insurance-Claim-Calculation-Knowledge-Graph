{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "iran-auto-claim.schema.json",
  "title": "Iran Auto Claim Calculation Case",
  "description": "Input contract for the Iranian motor claim rule engine. Every persisted and engine-bound monetary amount is a non-negative integer IRR. Display-unit conversion is outside this schema. Where authority leaves an operation unresolved the case must state that explicitly rather than omit the field.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "claim_id",
    "unit"
  ],
  "properties": {
    "claim_id": {
      "type": "string",
      "minLength": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "note": {
      "type": "string"
    },
    "unit": {
      "type": "string",
      "const": "IRR"
    },
    "regulatory_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "description": "Annual parameters frozen at the case's assessment date. Values here override the knowledge base's AnnualParameter nodes for that Iranian year.",
      "properties": {
        "as_of_date": {
          "type": "string",
          "format": "date",
          "description": "Gregorian ISO evaluation cutoff/provenance date. It is not the event date and does not select the event-effective rule snapshot."
        },
        "iranian_year": {
          "type": "integer"
        },
        "bodily_limit_irr": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "conventional_vehicle_threshold_irr": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "minimum_financial_limit_irr": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "annual_parameter_source": {
          "type": [
            "string",
            "null"
          ]
        },
        "annual_parameter_confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "domain": {
          "enum": [
            "BODY",
            "THIRD_PARTY_FINANCIAL",
            "LEGAL_RECOVERY"
          ]
        },
        "branch": {
          "description": "One of the seven ontology Branch values, or a documented test-variant alias (see ontology.json branch_aliases).",
          "enum": [
            "PARTIAL_DAMAGE",
            "TOTAL_LOSS",
            "GLASS_ONLY",
            "THEFT",
            "THIRD_PARTY_FINANCIAL",
            "ARTICLE_8_NON_CONVENTIONAL",
            "LEGAL_RECOVERY",
            "TOTAL_LOSS_TEST",
            "TOTAL_THEFT",
            "ARTICLE_8_DUAL_COVERAGE",
            "ORDINARY_FINANCIAL",
            "THEFT_PARTIAL_DAMAGE"
          ]
        },
        "variant": {
          "description": "Sub-mode selected within a branch. Usually derived from the branch alias.",
          "type": [
            "string",
            "null"
          ],
          "enum": [
            null,
            "THRESHOLD_TEST",
            "TOTAL_SETTLEMENT",
            "PENDING",
            "DUAL_COVERAGE",
            "ATTEMPTED_THEFT",
            "PARTS_THEFT",
            "ORDINARY_FINANCIAL"
          ]
        },
        "classification_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "override": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "authorized",
            "actor",
            "reason",
            "source",
            "timestamp"
          ],
          "properties": {
            "authorized": {
              "const": true
            },
            "actor": {
              "type": "string",
              "minLength": 1
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "source": {
              "type": "string",
              "minLength": 1
            },
            "timestamp": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})$"
            }
          }
        }
      }
    },
    "vehicle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "vehicle_type": {
          "type": "string"
        },
        "is_passenger_car": {
          "type": "boolean"
        },
        "production_year_shamsi": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Shamsi production/model year. It may not be later than the Iranian year of the event."
        },
        "market_value_at_event_irr": {
          "type": "integer",
          "minimum": 0
        },
        "insured_sum_irr": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "salvage_value_irr": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "salvage_disposition": {
          "enum": [
            "NOT_APPLICABLE",
            "INSURED_RETAINS",
            "INSURER_TAKES_TITLE",
            "UNRESOLVED"
          ]
        },
        "title_transferred_to_insurer": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "title_transferred": {
          "type": "boolean"
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "event_date": {
          "type": "string",
          "description": "Occurrence date. Compatibility contract: YYYY/MM/DD is Shamsi; YYYY-MM-DD in years 1300-1500 is legacy Shamsi; YYYY-MM-DD in years 1600-9999 is Gregorian; other year/separator combinations are ambiguous and rejected."
        },
        "awareness_date": {
          "type": "string",
          "description": "Date the insured became aware of the loss, using the event-date calendar compatibility contract. It may not precede the event."
        },
        "declaration_date": {
          "type": "string",
          "description": "Date the loss was declared, using the event-date calendar compatibility contract. It may not precede the event or awareness."
        },
        "cause": {
          "type": "string"
        },
        "peril": {
          "type": "string"
        },
        "theft_type": {
          "enum": [
            "WHOLE_VEHICLE",
            "ATTEMPTED_VEHICLE_THEFT_DAMAGE",
            "PARTIAL_PARTS_THEFT",
            "PARTS_STOLEN_AFTER_ACCIDENT"
          ]
        },
        "days_vehicle_missing": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "theft_clock": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start_event",
            "start_date",
            "as_of_date",
            "calendar",
            "source"
          ],
          "properties": {
            "start_event": {
              "enum": [
                "THEFT_OCCURRENCE",
                "AWARENESS",
                "DECLARATION"
              ]
            },
            "start_date": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            "as_of_date": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            "calendar": {
              "enum": [
                "GREGORIAN",
                "SHAMSI"
              ]
            },
            "source": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "fault_status": {
          "enum": [
            "INSURED_FAULT",
            "THIRD_PARTY_FAULT",
            "SHARED",
            "UNKNOWN",
            "NOT_APPLICABLE",
            "INSURED_AT_FAULT",
            "THIRD_PARTY_AT_FAULT",
            "NO_OTHER_PARTY",
            "UNDETERMINED"
          ]
        },
        "intoxication_causally_confirmed": {
          "type": "boolean"
        },
        "valid_licence": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "damaged_property_type": {
          "enum": [
            "PASSENGER_VEHICLE",
            "NON_VEHICLE_PROPERTY",
            "NON_PASSENGER_VEHICLE"
          ]
        }
      }
    },
    "damage": {
      "type": "object",
      "additionalProperties": false,
      "description": "Assessed damage. Either itemise `parts` + `labor`, or supply an aggregate `gross_damage_irr`. The scalar shorthand keys are accepted for assessment-estimator integration and fixture readability; they normalise into the same Part records.",
      "properties": {
        "theft_type": {
          "enum": [
            "WHOLE_VEHICLE",
            "ATTEMPTED_VEHICLE_THEFT_DAMAGE",
            "PARTIAL_PARTS_THEFT",
            "PARTS_STOLEN_AFTER_ACCIDENT"
          ]
        },
        "labor_irr": {
          "type": "integer",
          "minimum": 0
        },
        "gross_damage_irr": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "repair_total_irr": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "repair_and_replacement_irr": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "rescue_transport_actual_irr": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "Actual incurred rescue/transport expense before the applicable cap; distinct from the threshold operand and from any already-reimbursable amount."
        },
        "rescue_for_total_loss_test_irr": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "Rescue amount admitted to the Article 19 total-loss numerator; distinct from settlement rescue actual/payable values."
        },
        "rescue_for_total_loss_test_source": {
          "enum": [
            "EXPLICIT_THRESHOLD_OPERAND",
            "DERIVED_FROM_ACTUAL_RESCUE"
          ],
          "description": "Provenance for the distinct total-loss classification rescue operand. DERIVED_FROM_ACTUAL_RESCUE requires a matching actual-rescue operand; EXPLICIT_THRESHOLD_OPERAND requires a supplied threshold operand. Neither provenance token can be asserted independently."
        },
        "repair_total_includes_rescue": {
          "type": "boolean",
          "description": "True only when the supplied repair/replacement aggregate already embeds rescue; a positive separate rescue then requires evidenced decomposition before classification."
        },
        "rescue_omission_legacy_compatibility": {
          "type": "boolean",
          "description": "Explicit opt-in for a legacy imported case that historically treated omitted rescue as arithmetic zero. It is not evidence that no rescue occurred and is never emitted by Review."
        },
        "assessed_depreciation_irr": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "depreciable_parts_base_irr": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "depreciation_rate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "actual_financial_loss_irr": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "article8_corresponding_damage_irr": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "parts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "category"
            ],
            "anyOf": [
              {
                "required": [
                  "assessed_loss_irr"
                ]
              },
              {
                "required": [
                  "assessed_loss"
                ]
              }
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "category": {
                "enum": [
                  "GLASS",
                  "LAMP_GLASS",
                  "BATTERY",
                  "TIRE",
                  "OTHER_REPLACEMENT_PART",
                  "REPAIR_ONLY"
                ]
              },
              "new_price_irr": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "assessed_loss_irr": {
                "type": "integer",
                "minimum": 0
              },
              "assessed_loss": {
                "type": "integer",
                "minimum": 0
              },
              "requires_replacement": {
                "type": "boolean"
              },
              "article8_corresponding_part_irr": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              }
            }
          }
        },
        "labor": {
          "type": "integer",
          "minimum": 0
        },
        "gross": {
          "type": "integer",
          "minimum": 0
        },
        "gross_damage": {
          "type": "integer",
          "minimum": 0
        },
        "repair": {
          "type": "integer",
          "minimum": 0
        },
        "repair_total": {
          "type": "integer",
          "minimum": 0
        },
        "market": {
          "type": "integer",
          "minimum": 0
        },
        "market_value": {
          "type": "integer",
          "minimum": 0
        },
        "insured": {
          "type": "integer",
          "minimum": 0
        },
        "insured_sum": {
          "type": "integer",
          "minimum": 0
        },
        "franchise": {
          "type": "integer",
          "minimum": 0
        },
        "franchise_from_policy": {
          "type": "integer",
          "minimum": 0
        },
        "depreciation": {
          "type": "integer",
          "minimum": 0
        },
        "depreciable_parts": {
          "type": "integer",
          "minimum": 0
        },
        "rescue": {
          "type": "integer",
          "minimum": 0
        },
        "actual_rescue": {
          "type": "integer",
          "minimum": 0
        },
        "rescue_payable": {
          "type": "integer",
          "minimum": 0,
          "description": "Separately supplied reimbursable rescue amount after upstream admissibility/capping. It is not an alias of actual expense, is never copied into rescue_transport_actual_irr, and must not exceed the applicable engine-verified ceiling."
        },
        "rescue_for_threshold": {
          "type": "integer",
          "minimum": 0
        },
        "salvage": {
          "type": "integer",
          "minimum": 0
        },
        "salvage_value": {
          "type": "integer",
          "minimum": 0
        },
        "battery_loss": {
          "type": "integer",
          "minimum": 0
        },
        "battery_new_price": {
          "type": "integer",
          "minimum": 0
        },
        "tire_loss": {
          "type": "integer",
          "minimum": 0
        },
        "tires_new_price": {
          "type": "integer",
          "minimum": 0
        },
        "lamp_glass": {
          "type": "integer",
          "minimum": 0
        },
        "other_replacement_part": {
          "type": "integer",
          "minimum": 0
        },
        "other_part_depreciation_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "actual_damage": {
          "type": "integer",
          "minimum": 0
        },
        "corresponding_damage": {
          "type": "integer",
          "minimum": 0
        },
        "similar_part_corresponding_damage": {
          "type": "integer",
          "minimum": 0
        },
        "policy_financial_limit": {
          "type": "integer",
          "minimum": 0
        },
        "tp_limit": {
          "type": "integer",
          "minimum": 0
        },
        "vehicle_value": {
          "type": "integer",
          "minimum": 0
        },
        "victim_vehicle_value": {
          "type": "integer",
          "minimum": 0
        },
        "conventional_threshold": {
          "type": "integer",
          "minimum": 0
        },
        "threshold": {
          "type": "integer",
          "minimum": 0
        },
        "body_insurer_paid": {
          "type": "integer",
          "minimum": 0
        },
        "glass_franchise_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "whole_car_ratio": {
          "type": "number",
          "minimum": 0
        },
        "article8_whole_car_ratio": {
          "type": "number",
          "minimum": 0
        },
        "proportional_ratio": {
          "type": "number",
          "minimum": 0
        },
        "article8_proportional_ratio": {
          "type": "number",
          "minimum": 0
        },
        "glass_only_franchise_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "universal_glass_franchise": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "days_missing": {
          "type": "integer",
          "minimum": 0
        },
        "production_year": {
          "type": "integer"
        },
        "cause": {
          "type": "string"
        },
        "peril": {
          "type": "string"
        },
        "property_type": {
          "type": "string"
        },
        "salvage_disposition": {
          "enum": [
            "NOT_APPLICABLE",
            "INSURED_RETAINS",
            "INSURER_TAKES_TITLE",
            "UNRESOLVED"
          ]
        },
        "title_transferred": {
          "type": "boolean"
        },
        "glass_endorsement": {
          "type": "boolean"
        },
        "endorsement": {
          "type": "boolean"
        },
        "partial_theft_endorsement": {
          "type": "boolean"
        },
        "has_body_policy": {
          "type": "boolean"
        },
        "body_franchise_for_excess_disclosed": {
          "type": "boolean"
        },
        "insured_preserved_recovery_rights": {
          "type": "boolean"
        },
        "insured_released_responsible_party": {
          "type": "boolean"
        },
        "responsible_third_party_identified": {
          "type": "boolean"
        },
        "recovery_right_impaired": {
          "type": "boolean"
        },
        "replacement_parts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "allOf": [
              {
                "anyOf": [
                  {
                    "required": [
                      "type"
                    ]
                  },
                  {
                    "required": [
                      "category"
                    ]
                  }
                ]
              },
              {
                "anyOf": [
                  {
                    "required": [
                      "loss"
                    ]
                  },
                  {
                    "required": [
                      "assessed_loss"
                    ]
                  }
                ]
              }
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "GLASS",
                  "LAMP_GLASS",
                  "BATTERY",
                  "TIRE",
                  "OTHER_REPLACEMENT_PART",
                  "REPAIR_ONLY"
                ]
              },
              "category": {
                "enum": [
                  "GLASS",
                  "LAMP_GLASS",
                  "BATTERY",
                  "TIRE",
                  "OTHER_REPLACEMENT_PART",
                  "REPAIR_ONLY"
                ]
              },
              "loss": {
                "type": "integer",
                "minimum": 0
              },
              "assessed_loss": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "insurer": {
          "type": "string",
          "minLength": 1
        },
        "policy_version": {
          "type": "string",
          "minLength": 1
        },
        "third_party_financial_limit_irr": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "endorsements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "has_body_policy": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "glass_valuation_condition": {
          "enum": [
            "CONDITION_ABSENT",
            "REQUIRES_INSURED_AT_MARKET_VALUE",
            "HAS_VALUATION_CEILING",
            "WORDING_NOT_OBTAINED"
          ]
        },
        "multiple_insurance": {
          "type": "object",
          "additionalProperties": false,
          "description": "Two distinct admission facts: state records only whether another policy covers the same vehicle/risk; prior_compensation records compensation already received for the same damage from any source. Positive recovery is not proof of another policy.",
          "required": [
            "state",
            "prior_compensation"
          ],
          "properties": {
            "state": {
              "description": "Whether another policy covers the same vehicle and risk; this does not identify the source of prior compensation.",
              "enum": [
                "NO",
                "YES_OTHER_POLICIES",
                "YES_SAME_INSURER",
                "UNKNOWN"
              ]
            },
            "prior_compensation": {
              "description": "Non-negative integer IRR already received for the same damage from any source, including a responsible third party; explicit zero is distinct from omission.",
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "franchise": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "mode",
            "source"
          ],
          "properties": {
            "mode": {
              "enum": [
                "ABSOLUTE",
                "PERCENT",
                "PERCENT_WITH_MINIMUM"
              ]
            },
            "absolute_irr": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "rate": {
              "type": [
                "number",
                "null"
              ]
            },
            "minimum_irr": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "calculation_base": {
              "enum": [
                "ASSESSED_GROSS",
                "GROSS_ELIGIBLE",
                "AFTER_DEPRECIATION",
                "AFTER_SALVAGE",
                "SETTLEMENT_BASE",
                null
              ]
            },
            "claim_sequence_rule": {
              "type": [
                "string",
                "null"
              ]
            },
            "coverage_specific_rule": {
              "type": [
                "string",
                "null"
              ]
            },
            "source": {
              "enum": [
                "POLICY",
                "ENDORSEMENT",
                "INSURER_MANUAL",
                "UNKNOWN"
              ]
            },
            "source_reference": {
              "type": [
                "string",
                "null"
              ]
            },
            "source_version": {
              "type": [
                "string",
                "null"
              ]
            },
            "authority": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "source_reference": {
                  "type": "string",
                  "minLength": 1
                },
                "source_version": {
                  "type": "string",
                  "minLength": 1
                },
                "insurer": {
                  "type": "string",
                  "minLength": 1
                },
                "product": {
                  "type": "string",
                  "minLength": 1
                },
                "policy_reference": {
                  "type": "string",
                  "minLength": 1
                },
                "effective_from": {
                  "type": "string",
                  "minLength": 1
                },
                "effective_until": {
                  "type": "string",
                  "minLength": 1
                },
                "clause_locator": {
                  "type": "string",
                  "minLength": 1
                },
                "reviewer": {
                  "type": "string",
                  "minLength": 1
                },
                "document_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "source_status": {
                  "enum": [
                    "VERIFIED",
                    "UNRESOLVED",
                    "SYNTHETIC_TEST"
                  ]
                },
                "governs_contract": {
                  "type": "boolean"
                },
